rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isNoventraOwner() {
      return signedIn() && request.auth.uid == "LOJRpQAZYoZ9xCmXq8KpeQHXIuA3";
    }
    function isAdmin() {
      return signedIn() && (request.auth.token.role == 'admin' || isNoventraOwner());
    }
    function isModerator() {
      return signedIn() && (
        request.auth.token.role == 'admin' ||
        request.auth.token.role == 'moderator' ||
        isNoventraOwner()
      );
    }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if signedIn()
        && request.auth.uid == uid
        && !request.resource.data.keys().hasAny(['role', 'isAdmin', 'permissions']);
      allow update: if signedIn()
        && request.auth.uid == uid
        && !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['role', 'isAdmin', 'permissions']);
      allow delete: if isAdmin();
    }

    // Client may submit metadata, but cannot approve, reject or publish.
    match /fileSubmissions/{submissionId} {
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.approved == false
        && request.resource.data.keys().hasOnly([
          'ownerUid', 'originalName', 'storagePath', 'contentType',
          'size', 'section', 'purpose', 'createdAt', 'status', 'approved'
        ])
        && request.resource.data.storagePath.matches(
          '^quarantine/' + request.auth.uid + '/[A-Za-z0-9_-]+$'
        )
        && request.resource.data.section in ['sewing', 'kitchen', 'programming']
        && request.resource.data.purpose in [
          'question_attachment', 'lesson', 'paid_product', 'profile'
        ]
        && request.resource.data.size is int
        && request.resource.data.size > 0
        && request.resource.data.size <= 25 * 1024 * 1024;
      allow read: if signedIn() &&
        (resource.data.ownerUid == request.auth.uid || isModerator());
      allow update, delete: if false;
    }

    match /fileReviews/{reviewId} {
      allow read: if signedIn() &&
        (resource.data.ownerUid == request.auth.uid || isModerator());
      allow write: if false;
    }

    match /publishedFiles/{fileId} {
      allow read: if resource.data.status == 'approved';
      allow write: if false;
    }

    match /reports/{reportId} {
      allow create: if signedIn()
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.status == 'open';
      allow read: if isModerator() ||
        (signedIn() && resource.data.reporterUid == request.auth.uid);
      allow update, delete: if false;
    }

    match /questions/{questionId} {
      // Signed-in learners can read the shared Q&A board.
      allow read: if signedIn();

      // Learners can only create their own unanswered questions.
      allow create: if signedIn()
        && request.resource.data.keys().hasAll([
          'title', 'body', 'category', 'authorUid', 'authorName',
          'status', 'answer', 'createdAt', 'answeredAt', 'answeredBy'
        ])
        && request.resource.data.keys().hasOnly([
          'title', 'body', 'category', 'authorUid', 'authorName',
          'status', 'answer', 'createdAt', 'answeredAt', 'answeredBy'
        ])
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 3
        && request.resource.data.title.size() <= 150
        && request.resource.data.body is string
        && request.resource.data.body.size() >= 5
        && request.resource.data.body.size() <= 5000
        && request.resource.data.status == 'pending'
        && request.resource.data.answer == ''
        && request.resource.data.answeredBy == null;

      // Only the configured site owner can publish an answer.
      allow update: if isNoventraOwner()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['answer', 'status', 'answeredAt', 'answeredBy'])
        && request.resource.data.status == 'answered'
        && request.resource.data.answer is string
        && request.resource.data.answer.size() <= 5000
        && request.resource.data.answeredBy == request.auth.uid;
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}